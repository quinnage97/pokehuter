# PokéHunter server settings. On the server this file lives at /etc/pokehunter.env.
# Deal rules (discounts, conditions, alerts) are changed on the website's Settings tab.

# eBay developer portal -> Application Keys -> *Production* keyset
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Your postcode makes postage prices accurate (optional).
EBAY_DELIVERY_POSTCODE=

# Telegram: bot token from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Password for the website (any username works).
SITE_PASSWORD=
# Link included in alerts.
PUBLIC_URL=https://pokehunter-nq.duckdns.org/

# Optional: photo check for fakes. Easier to paste the key on the website's Settings tab.
# ANTHROPIC_API_KEY=

# Optional tweaks
# SCAN_INTERVAL_MINUTES=30
# POKEMON=Charizard,Mew
# EBAY_DAILY_CALL_BUDGET=4500
