# eBay production application credentials. Never commit the real values.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_CURRENCY=GBP
EBAY_DELIVERY_COUNTRY=GB
# Recommended for accurate calculated shipping; use the delivery-area postcode.
EBAY_DELIVERY_POSTCODE=
EBAY_CATEGORY_ID=183454
EBAY_SEARCH_QUERIES=Charizard pokemon card,Mew pokemon card

# Must exactly match the HTTPS URL entered in the eBay developer portal.
EBAY_DELETION_ENDPOINT=https://example.com/webhooks/ebay/account-deletion
# 32-80 characters; letters, numbers, underscores and hyphens only.
EBAY_VERIFICATION_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATABASE_PATH=/var/lib/pokehunter/pokehunter.sqlite3
LOG_LEVEL=INFO

# Bargain policy (active eBay asking-price comparisons, not sold prices).
MIN_DISCOUNT_PERCENT=20
MIN_SAVINGS=10
MIN_BARGAIN_SCORE=60
MIN_COMPARABLES=3
TITLE_SIMILARITY_THRESHOLD=0.45
REQUIRE_ENGLISH=true
