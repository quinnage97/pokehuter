[Unit]
Description=PokéHunter eBay bargain scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pokehunter
Group=pokehunter
WorkingDirectory=/opt/pokehunter
EnvironmentFile=/etc/pokehunter.env
ExecStart=/usr/bin/flock -n /var/lib/pokehunter/monitor.lock /opt/pokehunter/.venv/bin/pokehunter monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pokehunter
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
