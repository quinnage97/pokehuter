[Unit]
Description=PokéHunter eBay compliance webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pokehunter-web
Group=pokehunter-web
WorkingDirectory=/opt/pokehunter/current
EnvironmentFile=/etc/pokehunter.env
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=EBAY_CLIENT_ID EBAY_CLIENT_SECRET EBAY_AFFILIATE_CAMPAIGN_ID
UnsetEnvironment=EBAY_AFFILIATE_REFERENCE_ID EBAY_DELIVERY_POSTCODE EBAY_SEARCH_QUERIES
UnsetEnvironment=TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID DATABASE_PATH
ExecStart=/opt/pokehunter/current/.venv/bin/pokehunter serve --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pokehunter
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
SystemCallArchitectures=native
CPUWeight=20
IOWeight=20
MemoryMax=256M
TasksMax=64
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
